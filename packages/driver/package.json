{
  "name": "leopold-driver",
  "version": "0.5.0",
  "description": "Leopold SDK driver: a persistent conductor that orchestrates fresh Claude Code workers per task, decides from your charter, and notifies you. Uses your Claude Code auth. Git stays locked.",
  "type": "module",
  "bin": {
    "leopold-driver": "dist/index.js",
    "leopold": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonhvmp/leopold.git",
    "directory": "packages/driver"
  },
  "homepage": "https://github.com/Jonhvmp/leopold/tree/main/packages/driver#readme",
  "bugs": {
    "url": "https://github.com/Jonhvmp/leopold/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "ai-agents",
    "agent-harness",
    "autonomous-agents",
    "orchestration",
    "anthropic"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/protocol.test.ts test/guard.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.179"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": "Jonhvmp"
}
